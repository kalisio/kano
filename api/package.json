{
  "name": "kano-api",
  "description": "Kalisio Kano Application Web Services",
  "version": "2.8.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "homepage": "https://github.com/kalisio/kano",
  "keywords": [
    "kalisio"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/kano.git"
  },
  "author": {
    "name": "Kalisio contributors",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "bugs": {
    "url": "https://github.com/kalisio/kano/issues"
  },
  "main": "main.js",
  "scripts": {
    "release:patch": "npm --no-git-tag-version version patch",
    "release:minor": "npm --no-git-tag-version version minor",
    "release:major": "npm --no-git-tag-version version major",
    "dev": "cross-env NODE_ENV=development node --conditions=development --watch src/main.js",
    "debug": "cross-env NODE_ENV=development node --conditions=development --watch --inspect src/main.js",
    "dev:replica": "nodemon --watch src --exec pnpm debug:replica",
    "debug:replica": "cross-env NODE_ENV=development node --conditions=development --inspect=localhost:9230 src/main.js",
    "prod": "cross-env NODE_ENV=production node --conditions=development src/main.js",
    "lint": "standard src/**/*.js test/**/*.js --fix",
    "mocha": "cross-env NODE_OPTIONS=--conditions=development NODE_CONFIG_DIR=./test/config/ LAYERS_FILTER=\"OSM_BRIGHT TELERAY\" SUBDOMAIN= mocha --exit",
    "coverage": "c8 pnpm mocha",
    "test": "pnpm lint && pnpm coverage"
  },
  "standard": {
    "sourceType": "module",
    "env": [
      "mocha"
    ]
  },
  "dependencies": {
    "@feathersjs/authentication": "5.0.50",
    "@feathersjs/express": "5.0.50",
    "@feathersjs/feathers": "5.0.50",
    "@kalisio/common-core": "1.0.1",
    "@kalisio/common-graphics": "1.0.1",
    "@kalisio/feathers-automerge-server": "^0.4.0",
    "@kalisio/feathers-distributed": "3.1.0",
    "@kalisio/kdk": "~2.9.1",
    "@turf/turf": "^6.5.0",
    "feathers-hooks-common": "8.2.1",
    "feathers-mongodb-fuzzy-search": "2.0.1",
    "fs-extra": "11.4.1",
    "glob": "^7.1.6",
    "http-proxy-middleware": "^0.17.4",
    "is-docker": "2.2.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@feathersjs/client": "^5.0.50",
    "@slack/webhook": "^5.0.2",
    "c8": "^7.11.0",
    "chai": "^4.3.4",
    "chai-lint": "^0.1.1",
    "colors": "^1.1.2",
    "concat-stream": "^2.0.0",
    "cross-env": "^5.2.0",
    "mocha": "^9.1.1",
    "shelljs": "^0.8.5",
    "standard": "17.1.2"
  }
}
