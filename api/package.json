    "@kalisio/common-graphics": "catalog:",
    "@kalisio/feathers-automerge-server": "catalog:",
    "@kalisio/feathers-distributed": "catalog:",
    "@kalisio/kdk": "catalog:",
    "@turf/turf": "^6.5.0",
    "feathers-hooks-common": "catalog:",
    "feathers-mongodb-fuzzy-search": "catalog:",
