  "main": "main.js",
  "scripts": {
    "release:patch": "npm --no-git-tag-version version patch",
    "release:minor": "npm --no-git-tag-version version minor",
    "release:major": "npm --no-git-tag-version version major",
    "dev": "cross-env NODE_ENV=development node --conditions=development --watch src/main.js",
    "debug": "cross-env NODE_ENV=development node --conditions=development --watch --inspect src/main.js",
    "dev:replica": "nodemon --watch src --exec pnpm debug:replica",
    "debug:replica": "cross-env NODE_ENV=development node --conditions=development --inspect=localhost:9230 src/main.js",
    "prod": "cross-env NODE_ENV=production node --conditions=development src/main.js",
    "lint": "standard src/**/*.js test/**/*.js --fix",
    "mocha": "cross-env NODE_OPTIONS=--conditions=development NODE_CONFIG_DIR=./test/config/ LAYERS_FILTER=\"OSM_BRIGHT TELERAY\" SUBDOMAIN= mocha --exit",
    "coverage": "c8 pnpm mocha",
    "test": "pnpm lint && pnpm coverage"
  },
  "standard": {
    "sourceType": "module",
    "env": [
      "mocha"
    ]
  },
  "dependencies": {
    "@feathersjs/authentication": "catalog:",
    "@feathersjs/express": "catalog:",
    "@feathersjs/feathers": "catalog:",
