    "is-docker": "catalog:",
    "winston": "catalog:"
  },
  "devDependencies": {
    "@feathersjs/client": "catalog:",
    "c8": "^7.11.0",
    "chai": "^4.3.4",
    "chai-lint": "^0.1.1",
    "cross-env": "catalog:",
    "mocha": "^9.1.1",
    "standard": "catalog:"
  },
